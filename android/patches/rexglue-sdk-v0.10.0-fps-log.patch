+  const auto fps_now = std::chrono::steady_clock::now();
+  const auto fps_elapsed_ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(fps_now - fps_last_time).count();
+  if (fps_elapsed_ms >= 5000) {
+    const double fps = fps_frames * 1000.0 / double(fps_elapsed_ms > 0 ? fps_elapsed_ms : 1);
+    const double body_avg_ms = fps_frames ? double(fps_body_ms) / double(fps_frames) : 0.0;
+    REXGPU_WARN("present fps: {:.1f} ({} frames in {} ms, swap body avg {:.1f} ms)", fps,
