   SCOPE_profile_cpu_f("gpu");
+  // Android fork: per-second frame-rate log for on-device performance tuning
+  // (visible in the game log as a [gpu] warning so it shows at log_level=warning).
+  static auto fps_last_time = std::chrono::steady_clock::now();
+  static uint32_t fps_frames = 0;
