diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
index 8a8c6b5..75838da 100644
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -77,6 +77,17 @@ REXCVAR_DEFINE_INT32(resolution_scale, 1, "GPU",
     .range(1, 8)
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
+// Diagnostic half-res (Android fork v1.1): render targets stay full size
+// (halving the allocation tripped an assert in librexgpu-xenos on Mali and
+// aborted boot). Only viewport+scissor are halved, so the GPU rasterizes
+// ~1/4 of the pixels of the full target. Image will show quarter-screen in
+// a corner; for fragment-bound FPS experiments only.
+REXCVAR_DEFINE_BOOL(gpu_half_res, false, "GPU",
+                     "Diagnostic half-res v1.1: halve viewport and scissor only "
+                     "(targets stay full size). Quarter-screen image, for FPS "
+                     "experiments on tile GPUs.")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 REXCVAR_DEFINE_BOOL(pre_mask_resolve_l2_block, true, "GPU",
                     "Pre-mask scaled resolve L2 blocks to the write range before iterating");
 
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
