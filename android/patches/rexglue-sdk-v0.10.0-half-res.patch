 namespace rex::graphics::vulkan {
 
 namespace {
@@ -5734,6 +5736,15 @@ void VulkanCommandProcessor::UpdateDynamicState(const draw_util::ViewportInfo& v
   }
   viewport.minDepth = viewport_info.z_min;
   viewport.maxDepth = viewport_info.z_max;
+  // Android fork (half-res v1.1): halve viewport+scissor only, targets stay
+  // full size (halving the allocation aborted boot on Mali). Quarter-screen
+  // image in a corner, but fragment work drops ~4x for the experiment.
+  if (REXCVAR_GET(gpu_half_res)) {
+    viewport.x *= 0.5f;
+    viewport.y *= 0.5f;
+    viewport.width = std::max(1.0f, viewport.width * 0.5f);
+    viewport.height = std::max(1.0f, viewport.height * 0.5f);
+  }
   SetViewport(viewport);
 
   // Scissor.
@@ -5743,6 +5754,12 @@ void VulkanCommandProcessor::UpdateDynamicState(const draw_util::ViewportInfo& v
   scissor.offset[1] *= draw_resolution_scale_y;
   scissor.extent[0] *= draw_resolution_scale_x;
   scissor.extent[1] *= draw_resolution_scale_y;
+  if (REXCVAR_GET(gpu_half_res)) {
+    scissor.offset[0] /= 2;
+    scissor.offset[1] /= 2;
+    scissor.extent[0] = std::max(1u, scissor.extent[0] / 2);
+    scissor.extent[1] = std::max(1u, scissor.extent[1] / 2);
+  }
   VkRect2D scissor_rect;
   scissor_rect.offset.x = int32_t(scissor.offset[0]);
   scissor_rect.offset.y = int32_t(scissor.offset[1]);
