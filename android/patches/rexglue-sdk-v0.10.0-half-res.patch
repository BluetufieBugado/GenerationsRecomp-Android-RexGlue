+REXCVAR_DECLARE(bool, gpu_half_res);
+
 // DEFINE_string(
 //     render_target_path_vulkan, "",
 //     "Render target emulation path to use on Vulkan.\n"
@@ -1868,9 +1870,14 @@ RenderTargetCache::RenderTarget* VulkanRenderTargetCache::CreateRenderTarget(Ren
   image_create_info.pNext = nullptr;
   image_create_info.flags = 0;
   image_create_info.imageType = VK_IMAGE_TYPE_2D;
-  image_create_info.extent.width = key.GetWidth() * draw_resolution_scale_x();
-  image_create_info.extent.height =
-      GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples) * draw_resolution_scale_y();
+  // Android fork (half-res experiment): halve the render target when
+  // gpu_half_res=true to measure fragment-bound time on tile GPUs.
+  const uint32_t half_div = REXCVAR_GET(gpu_half_res) ? 2 : 1;
+  image_create_info.extent.width =
+      std::max(1u, key.GetWidth() * draw_resolution_scale_x() / half_div);
+  image_create_info.extent.height = std::max(
+      1u, GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples) *
+              draw_resolution_scale_y() / half_div);
   image_create_info.extent.depth = 1;
   image_create_info.mipLevels = 1;
   image_create_info.arrayLayers = 1;
