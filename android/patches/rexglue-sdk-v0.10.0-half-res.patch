 REXCVAR_DEFINE_BOOL(vulkan_dynamic_rendering, true, "GPU/Vulkan",
-                    "Use VK_KHR_dynamic_rendering for Vulkan GPU emulation when supported by the "
-                    "device (falls back to render passes otherwise)")
+                     "Use VK_KHR_dynamic_rendering for Vulkan GPU emulation when supported by the "
